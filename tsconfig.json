{
  "compilerOptions": {
    "typeRoots": ["node_modules/@txikijs/types", "node_modules/@types", "types"],
    "module": "esnext",
    "target": "es2023",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "lib": [
      "ES5",
      "ES2015",
      "ES6",
      "ES2016",
      "ES7",
      "ES2017",
      "ES2018",
      "ES2019",
      "ES2020",
      "ES2021",
      "ES2022",
      "ES2023",
      "WebWorker"
    ],
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true
  }
}
